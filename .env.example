# GEMINI_API_KEY: API key untuk mengakses Gemini AI API.
# Digunakan untuk fitur prediksi kualitas udara.
# Dapatkan API key di https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL tempat aplikasi ini di-hosting.
# Digunakan untuk self-referential links, OAuth callbacks, dan API endpoints.
APP_URL="MY_APP_URL"
ADMIN_DEFAULT_PASSWORD=

# Turso Database Credentials (production)
# Buat database gratis di https://turso.tech
# Isi value di bawah untuk local testing, dan juga di Railway Project Settings -> Variables
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
